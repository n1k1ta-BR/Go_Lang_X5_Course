{
    "swagger": "2.0",
    "info": {
        "title": "Orders API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/orders": {
            "get": {
                "description": "Возвращает страницу заказов по возрастанию id. Фильтр применяется ко всему списку до пагинации. Пустая страница возвращается как []. Новые заказы имеют статус new, поэтому status=cancelled возвращает пустой массив до первой отмены. Явные пустые, повторные и неизвестные query-параметры запрещены. limit и offset допускают только десятичные цифры в диапазоне int.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "orders"
                ],
                "summary": "Получить список заказов",
                "parameters": [
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "default": 20,
                        "description": "Размер страницы",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "default": 0,
                        "description": "Количество пропускаемых заказов",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "new",
                            "cancelled"
                        ],
                        "type": "string",
                        "description": "Фильтр по статусу",
                        "name": "status",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/httpapi.OrderResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "INVALID_QUERY",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_ERROR",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "orders"
                ],
                "summary": "Создать заказ",
                "parameters": [
                    {
                        "description": "Данные для создания заказа",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.CreateOrderRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/httpapi.OrderResponse"
                        },
                        "headers": {
                            "Location": {
                                "type": "string",
                                "description": "Путь к созданному заказу"
                            }
                        }
                    },
                    "400": {
                        "description": "Некорректный запрос",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "Слишком большое тело запроса",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "415": {
                        "description": "Неподдерживаемый тип содержимого",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/orders/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "orders"
                ],
                "summary": "Получить заказ по id",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Положительный номер заказа",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.OrderResponse"
                        }
                    },
                    "400": {
                        "description": "INVALID_ID",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "ORDER_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_ERROR",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/orders/{id}/status": {
            "patch": {
                "description": "Разрешён переход new в cancelled. Повторная отмена возвращает 409 ORDER_ALREADY_CANCELLED.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "orders"
                ],
                "summary": "Отменить заказ",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Положительный номер заказа",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Новый статус заказа",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.UpdateStatusRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.OrderResponse"
                        }
                    },
                    "400": {
                        "description": "INVALID_ID, INVALID_JSON или VALIDATION_ERROR",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "ORDER_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "ORDER_ALREADY_CANCELLED",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "BODY_TOO_LARGE",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "415": {
                        "description": "UNSUPPORTED_MEDIA_TYPE",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_ERROR",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/status": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "status"
                ],
                "summary": "Проверить состояние API",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.StatusResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "httpapi.CreateOrderRequest": {
            "type": "object",
            "required": [
                "customer"
            ],
            "properties": {
                "customer": {
                    "type": "string",
                    "minLength": 1,
                    "example": "Алиса"
                }
            }
        },
        "httpapi.ErrorResponse": {
            "type": "object",
            "required": [
                "code",
                "error"
            ],
            "properties": {
                "code": {
                    "type": "string",
                    "example": "VALIDATION_ERROR"
                },
                "error": {
                    "type": "string",
                    "example": "customer is required"
                }
            }
        },
        "httpapi.OrderResponse": {
            "type": "object",
            "required": [
                "customer",
                "id",
                "status"
            ],
            "properties": {
                "customer": {
                    "type": "string",
                    "example": "Алиса"
                },
                "id": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "new",
                        "cancelled"
                    ],
                    "example": "new"
                }
            }
        },
        "httpapi.StatusResponse": {
            "type": "object",
            "required": [
                "status"
            ],
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "httpapi.UpdateStatusRequest": {
            "type": "object",
            "required": [
                "status"
            ],
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "cancelled"
                    ],
                    "example": "cancelled"
                }
            }
        }
    }
}